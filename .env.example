# Copy to .env (git-ignored) to run the opt-in sandbox tests: pnpm test
# Never put live keys here.
FEDAPAY_SANDBOX_SECRET_KEY=
# A FedaPay sandbox test phone number, in E.164 format (e.g. +229...)
FEDAPAY_SANDBOX_PHONE=
# Operator to test: mtn (default), moov or celtiis. It must be activated on the
# sandbox account (Dashboard → Configuration → Payment methods).
FEDAPAY_SANDBOX_NETWORK=mtn
