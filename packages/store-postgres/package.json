{
  "name": "@payenv/store-postgres",
  "version": "0.2.0",
  "description": "PostgreSQL store for Payenv: atomic idempotency, payment lookups for webhooks and reconciliation.",
  "license": "Apache-2.0",
  "author": "Jules Mahounou (https://github.com/jules-mahounou)",
  "homepage": "https://github.com/payenv-dev/payenv/tree/main/packages/store-postgres#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/payenv-dev/payenv.git",
    "directory": "packages/store-postgres"
  },
  "bugs": "https://github.com/payenv-dev/payenv/issues",
  "keywords": [
    "payenv",
    "postgres",
    "postgresql",
    "store",
    "idempotency",
    "payments"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@payenv/core": "workspace:^"
  },
  "devDependencies": {
    "@payenv/core": "workspace:^",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  },
  "publishConfig": {
    "access": "public"
  }
